# Only bootstrap values for the containers themselves live here. Flow reads
# every secret from OpenBao: openbao-init copies POSTGRES_PASSWORD,
# CLICKHOUSE_PASSWORD and NATS_TOKEN into OpenBao (flow/postgres, flow/clickhouse,
# flow/nats) on the first start, and the setup wizard only stores references.

# Passwords of the bundled services (set once; changing them later needs a change in the service and in OpenBao).
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
NATS_TOKEN=change-me-nats
# Read-only ClickHouse user "grafana" (Grafana datasource, --profile grafana or an external Grafana)
CLICKHOUSE_GRAFANA_PASSWORD=change-me-clickhouse-grafana

# Flow
FLOW_IMAGE=umbrella-flow:latest
FLOW_VERSION=dev
FLOW_HTTP_BIND=0.0.0.0
FLOW_HTTP_PORT=8080
FLOW_NETFLOW_PORT=2055
FLOW_SFLOW_PORT=6343
# BMP (TCP); the receiver listens only while enabled under Settings → BMP
FLOW_BMP_PORT=10179
# true behind HTTPS (reverse proxy)
FLOW_SECURE_COOKIES=false
# Addresses / networks of reverse proxies whose X-Forwarded-For is trusted
FLOW_TRUSTED_PROXIES=
FLOW_STARTUP_WAIT=2m
# Fixed setup code (empty = random, printed in the log and kept in the data volume)
FLOW_SETUP_TOKEN=
# Wizard prefill
FLOW_LANGUAGE=ru
FLOW_PUBLIC_URL=
FLOW_INVENTORY_URL=
FLOW_UMBRELLA_INGEST_URL=
# With --profile geoip: /geoip/GeoLite2-City.mmdb,/geoip/GeoLite2-ASN.mmdb
FLOW_GEOIP_DATABASES=
TZ=UTC

# ClickHouse
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
CLICKHOUSE_MEMORY_LIMIT=4g
CLICKHOUSE_BIND=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123

# OpenBao
OPENBAO_IMAGE=openbao/openbao:2.7.1
OPENBAO_BIND=127.0.0.1
OPENBAO_PORT=8200
OPENBAO_AUTO_UNSEAL=true

# --profile geoip (MaxMind account: https://www.maxmind.com/en/geolite2/signup)
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
GEOIPUPDATE_EDITION_IDS=GeoLite2-ASN GeoLite2-City GeoLite2-Country
GEOIPUPDATE_FREQUENCY=72

# --profile grafana (Grafana 13 with the "CI traffic" dashboard)
GRAFANA_IMAGE=grafana/grafana:13.2.3
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# Join the shared network "umbrella" (Umbrella Monitoring, Inventory DB):
# COMPOSE_FILE=docker-compose.yml:docker-compose.umbrella.yml
