<!-- Umbrella Flow: server settings for a single-node installation. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <size>100M</size>
        <count>5</count>
    </logger>
    <!-- Leave room for the OS and the page cache inside the container limit (mem_limit). -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_concurrent_queries>100</max_concurrent_queries>
    <!-- BACKUP DATABASE flow TO File('…') writes here (see README). -->
    <backups>
        <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
    </backups>
    <!-- System logs grow fast: keep them short. -->
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <engine>ENGINE = MergeTree PARTITION BY event_date ORDER BY event_time TTL event_date + INTERVAL 7 DAY</engine>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <latency_log remove="1"/>
    <processors_profile_log remove="1"/>
</clickhouse>
